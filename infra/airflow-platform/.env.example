# Reference only. Run Initialize-LocalEnv.ps1 to generate a real .env.
# This file belongs to the shared platform. Source login is configured separately.
AIRFLOW_UID=50000
AIRFLOW_UI_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=GENERATE_WITH_SCRIPT
METADATA_PASSWORD=GENERATE_WITH_SCRIPT
AIRFLOW_FERNET_KEY=GENERATE_WITH_SCRIPT
AIRFLOW_API_SECRET_KEY=GENERATE_WITH_SCRIPT
AIRFLOW_JWT_SECRET=GENERATE_WITH_SCRIPT
WAREHOUSE_PASSWORD=GENERATE_WITH_SCRIPT
LAPLAPTECH_PIPELINE_PASSWORD=GENERATE_WITH_SCRIPT
LAPLAPTECH_DASHBOARD_PASSWORD=GENERATE_WITH_SCRIPT
DOCKER_SOCKET_GID=0
# Absolute repository path, using forward slashes. Set by Start-LocalStack.ps1.
LAPLAPTECH_PROJECT_DIR=C:/path/to/laplaptech_pipeline
WAREHOUSE_HOST_PORT=55434
DASHBOARD_PORT=8501
# Resource values are derived from resources.json by Configure-Resources.ps1.
# Edit the policy; do not hand-maintain separate service/task limits here.
