# ClickHouse (Source)
CLICKHOUSE_HOST=applog.xomdata.com
CLICKHOUSE_PORT=80
# true cho HTTPS (thường là 8443), false cho HTTP (80)
CLICKHOUSE_SECURE=false
CLICKHOUSE_USER=xomdata
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DATABASE=laplaptech

# PostgreSQL (Warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=55434
POSTGRES_USER=laplaptech
POSTGRES_PASSWORD=laplaptech_lab_only
POSTGRES_DATABASE=laplaptech_pipeline_dev
# Docker PostgreSQL local. Inside containers the host is warehouse-laplaptech:5432.
POSTGRES_SSLMODE=prefer
# Compose creates this database. No application-side database creation.
POSTGRES_CREATE_DATABASE=false
# Epoch giây; mặc định 2 giờ, khớp cửa sổ Silver hiện tại
INGESTION_LOOKBACK_SECONDS=7200

# Optional dashboard override for a LOCAL dev preview; leave unset to use POSTGRES_*.
# DASHBOARD_DATABASE_URL=postgresql+psycopg2://laplaptech:laplaptech_lab_only@localhost:55434/laplaptech_pipeline_dev
GOLD_SCHEMA=public_gold
