# ClickHouse (Source)
CLICKHOUSE_HOST=applog.xomdata.com
CLICKHOUSE_PORT=80
# true cho HTTPS (thường là 8443), false cho HTTP (80)
CLICKHOUSE_SECURE=false
CLICKHOUSE_USER=xomdata
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DATABASE=laplaptech

# PostgreSQL (Warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=laplaptech_pipeline
# Neon: require; PostgreSQL local không bật TLS: prefer
POSTGRES_SSLMODE=prefer
# Managed DB như Neon: giữ false. Chỉ bật khi muốn tạo DB local mới.
POSTGRES_CREATE_DATABASE=false
# Epoch giây; mặc định 2 giờ, khớp cửa sổ Silver hiện tại
INGESTION_LOOKBACK_SECONDS=7200

# Optional dashboard override for a LOCAL dev preview; leave unset to use POSTGRES_*.
# DASHBOARD_DATABASE_URL=postgresql+psycopg2://postgres:local_dev_only@localhost:55432/laplaptech_pipeline_dev
GOLD_SCHEMA=public_gold
